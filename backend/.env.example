# Server & Network Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://admin.your-domain.com
TRUST_PROXY=1

# Database Configuration (MongoDB Atlas Replica Set Recommended)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/QR_System_prod?retryWrites=true&w=majority
MONGO_URI_TEST=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/QR_System?retryWrites=true&w=majority

# Authentication Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_AUTH_API_MAX=500
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_DELAY_AFTER=3

# Cloudinary Media Storage (Tenant Isolated)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Delivery (Gmail / SendGrid / Amazon SES / Brevo)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key_or_app_password
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=WhatTheMenu
SIMULATE_EMAIL=false

# Razorpay Platform Credentials (Super Admin Subscription Gateway)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Razorpay Plan IDs (Created in Razorpay Dashboard for Subscriptions)
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_pro_monthly_id
RAZORPAY_PLAN_ID_PRO_YEARLY=plan_pro_yearly_id
RAZORPAY_PLAN_ID_PRO_PLUS_MONTHLY=plan_pro_plus_monthly_id
RAZORPAY_PLAN_ID_PRO_PLUS_YEARLY=plan_pro_plus_yearly_id
